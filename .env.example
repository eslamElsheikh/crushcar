DATABASE_URL="file:./dev.db"
# Required in production: src/instrumentation.ts refuses to boot when this is
# missing, shorter than 32 characters, or still the placeholder below.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="safrotravel-secret-key-change-in-production-abc123xyz"
NEXTAUTH_URL="http://localhost:3000"

# ── Trusted proxy (src/lib/clientIp.ts) ─────────────────────────────────────
# Rate limiting needs to know which address a request came from, and every
# X-Forwarded-style header is attacker-controlled until a proxy you operate
# overwrites it. Configure ONE of these when the app sits behind a proxy;
# with neither set, all callers share a single rate-limit bucket.
#
# Header set by exactly one appliance in front of the app (Cloudflare, nginx,
# a load balancer). Its value is taken as the client address:
#TRUSTED_PROXY_HEADER="CF-Connecting-IP"
# …or how many entries at the right end of X-Forwarded-For were appended by
# proxies you operate (1 = one proxy in front):
#TRUSTED_PROXY_HOPS="1"

# ── Cloudflare Turnstile (optional, item 6) ─────────────────────────────────
# Checked on register / login / checkout / public stats+analytics, but ONLY
# when both values are set and are not these placeholders. In production a
# request without a verifiable token is refused (403) once enabled.
# Create a pair at https://dash.cloudflare.com/?to=/:account/turnstile
#NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
#TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# ── Test harness ────────────────────────────────────────────────────────────
# Set by scripts/start-e2e-server.mjs for the Playwright run. Makes Turnstile
# a no-op (a headless browser cannot solve a challenge). Never set in prod.
#E2E="1"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="safrotravel <noreply@safrotravel.com>"