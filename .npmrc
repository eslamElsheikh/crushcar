# next-auth@5.0.0-beta.32 declares an *optional* peer on nodemailer@"^7.0.7 || ^8.0.5".
# Every nodemailer version in that range is affected by published advisories
# (SMTP/header injection, addressparser DoS, TLS validation); the fixed line is
# 10.x, which the peer range does not cover. We use next-auth's Credentials
# provider only, so its optional nodemailer integration is never loaded.
#
# npm treats the unsatisfiable optional peer as a hard ERESOLVE error, which
# would break `npm install` for everyone. Opting out of peer resolution keeps
# installs reproducible from package-lock.json without downgrading a security
# fix. Remove this file if next-auth ever widens its nodemailer peer range.
legacy-peer-deps=true
