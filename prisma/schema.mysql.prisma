// safrotravel Bus Booking Platform - Prisma Schema

generator client {
  provider = "prisma-client-js"
  // The production host is Node 22 on CloudLinux built against OpenSSL 1.1,
  // so the 1.1.x engine is the one that actually runs. It was missing from
  // this list, which generated a client with no usable engine and took every
  // API route down with PrismaClientInitializationError until the engines
  // were downloaded by hand.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  phone         String?   @default("")
  image         String?   // avatar URL (/api/uploads/...)
  role          String    @default("CUSTOMER") // SUPER_ADMIN | COMPANY_ADMIN | CUSTOMER
  permissions   String    @default("")
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  isActive      Boolean   @default(true)
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now())
  bookings      Booking[]
  /// Company bookings this user created. Populated when a super admin books on
  /// a company's behalf; empty for bookings a company made itself.
  companyBookingsCreated CompanyBooking[] @relation("CompanyBookingCreator")
}

model Company {
  id               String   @id @default(cuid())
  name             String
  subdomain        String   @unique
  plan             String   @default("STARTER") // STARTER | PRO | ENTERPRISE
  creditLimit      Float    @default(0)
  walletBalance    Float    @default(0)
  paymentMode      String   @default("PREPAID") // CREDIT | PREPAID | BOTH
  outstandingBalance Float  @default(0)
  billingCycle     String   @default("MONTHLY") // MONTHLY | WEEKLY
  lastBillingDate  DateTime?
  isActive         Boolean  @default(true)
  logoUrl          String?
  showLogoOnTicket Boolean  @default(false)
  // When true, a company booking is charged to the wallet/credit the moment it
  // is created, instead of waiting for someone to press "confirm payment".
  // Off means the booking stays PENDING and the company settles it itself.
  autoPayEnabled   Boolean  @default(false)
    // Ceiling on how many seats one company booking may cover. null = use
    // DEFAULT_MAX_SEATS_PER_BOOKING. 0 is not a valid value: use autoPayEnabled
    // and isActive to stop a company from booking.
    //
    // The business rule is a hard maximum of MAX_SEATS_PER_BOOKING (10). This
    // column may lower it for a company; it can never raise it, and the
    // server clamps it.
    maxSeatsPerBooking Int?
    // The overall daily seat cap: how many seats this company may hold on
    // ONE travel date, counted across every trip, route, direction and bus
    // on that date.
    //
    // null means no overall daily cap, which is the same as no limit. It is
    // not the same as the ten-seat per-booking cap above: that one is per
    // booking request, this one is per day, and the smaller of the two is
    // what applies.
    //
    // The travel date is the Cairo day of the trip's departure, the same day
    // the route allowance uses, so the two never disagree about which day a
    // seat belongs to.
    maxDailySeats     Int?
  users            User[]
  buses            Bus[]
  companyCustomers CompanyCustomer[]
  companyBookings  CompanyBooking[]
  walletTransactions WalletTransaction[]
  tripRequests     TripRequest[]
  depositRequests  DepositRequest[]
  creditLogs       CreditLog[]
  charterBookings  CharterBooking[]
    reservedTrips    Trip[]   @relation("CompanyReservedTrips")
    companyTripQuotas CompanyTripQuota[]
    companyRouteQuotas CompanyRouteQuota[]
  createdAt        DateTime @default(now())
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  type      String      // MINI_BUS | COACH_BUS | VIP_BUS | DOUBLE_DECKER | CHARTER
  seatCount Int
  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id])
  layout    BusLayout?
  stations  BusStation[]
  trips     Trip[]
  createdAt DateTime   @default(now())
}

model Station {
  id        String     @id @default(cuid())
  name      String
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime   @default(now())
  tripStops       TripStop[]
  tripRequestsFrom TripRequest[] @relation("TripRequestFrom")
  tripRequestsTo   TripRequest[] @relation("TripRequestTo")

  @@unique([name, city])
}

model BusStation {
  id        String   @id @default(cuid())
  busId     String
  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  createdAt DateTime @default(now())

  @@unique([busId, order])
}

model BusLayout {
  id        String  @id @default(cuid())
  busId     String  @unique
  bus       Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)
  rows      Int
  cols      Int     // max columns (e.g. 4 for 2+aisle+2)
  aisleAfter Int    @default(2) // aisle position (e.g. 2 = after column 2)
  colsPerRow String @default("") // JSON: "{"A":3,"B":4,"C":3,"D":4}" - actual seat count per row
  seats     Seat[]
}

model Seat {
  id       String    @id @default(cuid())
  layoutId String
  layout   BusLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  label    String
  row      Int
  col      Int
  type     String    @default("NORMAL") // NORMAL | VIP | DISABLED | HIDDEN
  price    Float     @default(0)
}

model Trip {
  id          String     @id @default(cuid())
  busId       String
  bus         Bus        @relation(fields: [busId], references: [id])
  origin      String
  destination String
  departure   DateTime
  arrival     DateTime
  price       Float
  seatPrice           Float?
  busPrice            Float?
  bookingMode         String     @default("SEAT") // SEAT | BUS | BOTH
  reservedByCompanyId String?
  reservedByCompany   Company?   @relation("CompanyReservedTrips", fields: [reservedByCompanyId], references: [id])
  status      String     @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  stopsJson   String     @default("[]") // JSON: [{stationId, name, order, arrivalTime?, departureTime?, price?}]
  /// The ordered station-id sequence of this trip, derived from its TripStop
  /// rows: "stationA|stationB|stationC".
  ///
  /// This is the route identity. Several buses serving the same route on the
  /// same day share one value, which is what a daily company quota is counted
  /// against. It is order-sensitive, so the reverse direction of a route is a
  /// different route.
  ///
  /// Null until derived, and null forever for a trip with no stops — such trips
  /// exist and are searchable, they just have no route identity.
  routeKey    String?
  /// The travel date as a Cairo calendar day, "yyyy-mm-dd", from departure.
  /// Null until derived.
  travelDate  String?
  bookings    Booking[]
  companyBookings CompanyBooking[]
  companyTripQuotas CompanyTripQuota[]
  charterBookings CharterBooking[]
  tripStops   TripStop[]
  seatHolds   SeatHold[]
  seatBlocks  SeatBlock[]
  createdAt   DateTime   @default(now())

  @@index([status, departure])
  @@index([routeKey, travelDate])
}

model TripStop {
  id              String    @id @default(cuid())
  tripId          String
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stationId       String
  station         Station   @relation(fields: [stationId], references: [id])
  stopOrder       Int
  priceFromOrigin Float
  arrivalTime     DateTime?
  departureTime   DateTime?

  @@unique([tripId, stopOrder])
  @@unique([tripId, stationId])
}

model SeatHold {
  id            String   @id @default(cuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seatLabel     String
  fromStopOrder Int
  toStopOrder   Int
  userId        String
  expiresAt     DateTime
}

/// Hands out the sequential part of a booking reference.
///
/// One row per calendar year, shared by Booking and CompanyBooking so the two
/// tables never hand out the same serial. The row is bumped with
/// INSERT ... ON DUPLICATE KEY UPDATE inside the same transaction that creates
/// the booking, which is why Prisma's upsert is not used: on MySQL/MariaDB it
/// is emulated rather than a single atomic statement, and two first bookings of
/// the year would race on the insert. See src/lib/booking-reference.ts.
model ReferenceCounter {
  id        String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Booking {
  id              String    @id @default(cuid())
  reference       String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  tripId          String
  trip            Trip      @relation(fields: [tripId], references: [id])
  seatLabel       String
  passengerName   String    @default("") // name of the actual traveler (may differ from buyer)
  passengerPhone  String    @default("") // phone number of the traveler (optional)
  passengerHotel  String    @default("")
  status          String    @default("PENDING") // PENDING | PAID | CANCELLED | BOARDED
  paidAt          DateTime?
  // Manual transfer proof (customer pays after booking, admin reviews)
  paymentMethod       String?   // VODAFONE_CASH | INSTAPAY
  paymentProofUrl     String?   // /api/uploads/... screenshot of the transfer
  paymentNotes        String?   @default("")
  paymentStatus       String    @default("NONE") // NONE | PENDING | REJECTED (awaiting review / needs new proof)
  paymentRejectReason String?   @default("")
  // Who paid for this booking. CUSTOMER = a customer paid by transfer, and the
  // receipt above is the evidence. PLATFORM = the platform's own wallet
  // covered it, so there is no receipt and no counterparty.
  //
  // This is the discriminator for revenue: a PLATFORM booking is money the
  // platform spent, not money it collected, so it is excluded from customer
  // revenue and reported as its own line.
  fundingSource        String    @default("CUSTOMER") // CUSTOMER | PLATFORM
  // Seat-holding window: a PENDING booking is cancelled once this passes with
  // no proof attached, releasing the seat. See src/lib/payments.ts.
  paymentExpiresAt DateTime?
  expiredAt        DateTime?   // set when a sweep cancelled it, so admins can tell
                                 // a timed-out booking from a customer cancellation
  groupId             String?   // links seats booked in one checkout (group pay)
  boarded         Boolean   @default(false)
  boardedAt       DateTime?
  total           Float
  roundTripGroupId String?  // links outbound + return bookings in a round trip
  returnForId     String?   // if this is a return booking, links to the outbound booking
  fromStopOrder   Int       @default(1)
  toStopOrder     Int       @default(1)
  cancelledAt       DateTime?
  cancelledBy       String?
  cancellationReason String? @db.Text @default("")
  refundAmount      Float?
  cancellationFee   Float?
  refundProcessedAt DateTime?
  refundProcessedBy String?
  createdAt         DateTime  @default(now())
  reminders         Reminder[]

  @@index([status, createdAt])
  @@index([tripId, status])
  @@index([userId, status])
  @@index([status, paymentExpiresAt])
}

model Reminder {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sentAt    DateTime @default(now())
  type      String   @default("24H") // 24H | 2H
}

model Faq {
  id         String   @id @default(cuid())
  questionAr String
  questionEn String
  answerAr   String @db.Text
  answerEn   String @db.Text
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model CompanyCustomer {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  notes       String? @db.Text  @default("")
  bookings    CompanyBooking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyBooking {
  id              String   @id @default(cuid())
  reference       String   @unique
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  customerId      String?
  customer        CompanyCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id])
  seatLabel       String
  passengerName   String   @default("")
  passengerPhone  String   @default("")
  passengerHotel  String   @default("")
  passengerNotes  String   @default("")
  collectAmount   Float?
  bookingType     String   @default("FOR_EMPLOYEE") // FOR_CLIENT | FOR_EMPLOYEE
  status          String   @default("PENDING") // PENDING | PAID | CANCELLED | BOARDED
  total           Float
  paidFromWallet  Float    @default(0)
  paidOnCredit    Float    @default(0)
  /// The authenticated user who created this booking. Set when a super admin
  /// books on the company's behalf; null for a booking the company made
  /// itself. This is the audit trail that separates the owner of the booking
  /// (companyId) from the person who made it.
  createdByUserId String?
  createdBy       User?    @relation("CompanyBookingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fromStopOrder   Int      @default(1)
  toStopOrder     Int      @default(1)
  expiresAt       DateTime? @map("expires_at")
  // Set when the sweep cancelled this booking, so an admin can tell a
  // timed-out booking from one a person cancelled. Mirrors Booking.expiredAt.
  expiredAt         DateTime?
  createdAt         DateTime @default(now())
  paidAt            DateTime?
  cancelledAt       DateTime?
  cancelledBy       String?
  cancellationReason String? @db.Text @default("")
  refundAmount      Float?
  cancellationFee   Float?
  refundProcessedAt DateTime?
  refundProcessedBy String?
  boardedAt         DateTime?
  roundTripGroupId  String?

  @@index([companyId, status])
  @@index([createdAt, status])
  @@index([createdByUserId])
}

/// How many seats one company may hold on one trip.
///
/// Set by a super admin per trip. A company with no row here has no limit on
/// that trip. The count is made live from the bookings themselves, not from a
/// stored counter, so a cancelled booking gives its seats back automatically
/// and the number can never drift away from reality.
model CompanyTripQuota {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  maxSeats  Int?     // null = no limit on this trip
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, tripId])
  @@index([tripId])
}

/// How many seats a company may hold on one route on one travel date.
///
/// The bucket is shared by every bus serving that route on that date: three
/// buses on Mansoura -> Sharm on the 20th all draw from one allowance, so a
/// company cannot take its full quota three times over by taking a bus each.
///
/// This is the daily allowance. CompanyTripQuota is the separate, stricter
/// cap on one single bus, and both apply when both are set — the effective
/// limit is the smaller of the two.
model CompanyRouteQuota {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// The trip's routeKey — the ordered station-id sequence.
  routeKey  String
  /// The travel date as a Cairo calendar day, "yyyy-mm-dd".
  travelDate String
  maxSeats  Int?     // null = no limit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, routeKey, travelDate])
  @@index([routeKey, travelDate])
}

/// The platform's own cash. One row, id = 'main'.
///
/// Separate from every Company wallet on purpose: the two ledgers have
/// different owners and no endpoint moves money between them. This is the
/// operator's float, and it funds platform-covered bookings.
///
/// Amounts are integer piastres, not floats. Company.walletBalance is a Float
/// and it has drifted from its ledger before; this ledger has to reconcile
/// exactly, because reconciliation is the only thing that proves the money is
/// real. SUM(amountPiastres) == balancePiastres needs no tolerance band.
model PlatformWallet {
  id               String   @id @default("main")
  balancePiastres  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Append-only ledger for the platform wallet.
///
/// balanceAfterPiastres is the balance immediately after this row was applied.
/// Chaining it through the ledger turns "the totals differ" into "row 412 is
/// the first one that disagrees", which is the difference between a useless
/// alarm and an audit.
///
/// idempotencyKey makes a retried request harmless: a booking charge and its
/// refund each carry a key derived from the booking, and the unique index
/// makes a second charge for the same booking impossible even if the request
/// is replayed with a different path through the code. It is null for manual
/// funding and adjustments, which are not tied to a booking.
model PlatformTransaction {
  id                    String   @id @default(cuid())
  type                  String   // FUNDING | BOOKING_CHARGE | REFUND | ADJUSTMENT
  amountPiastres        Int      // positive = cash in, negative = cash out
  balanceAfterPiastres  Int
  description           String   @default("")
  reference             String   @default("") // booking reference, funding reference
  idempotencyKey        String?  @unique
  actorId               String?
  actorEmail            String   @default("") // snapshot: the ledger outlives the account
  method                String   @default("") // CASH | BANK | ADJUSTMENT
  attachmentUrl         String?
  createdAt             DateTime @default(now())

  @@index([createdAt])
  @@index([reference])
}

model TripRequest {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromStationId   String
  fromStation     Station  @relation("TripRequestFrom", fields: [fromStationId], references: [id])
  toStationId     String
  toStation       Station  @relation("TripRequestTo", fields: [toStationId], references: [id])
  passengerCount  Int
  date            DateTime
  notes           String @db.Text   @default("")
  status          String   @default("PENDING")
  adminNotes      String @db.Text   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DepositRequest {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amount         Float
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  method         String?  // VODAFONE_CASH | INSTAPAY
  notes          String? @db.Text  @default("")
  adminNotes     String @db.Text   @default("")
  attachmentUrl  String   @default("")
  attachmentName String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WalletTransaction {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  type        String   // DEPOSIT | BOOKING_CHARGE | REFUND | ADJUSTMENT
  amount      Float    // positive = add, negative = deduct
  description String @db.Text   @default("")
  reference   String?  @default("") // bookingId
  /// Makes a retried request harmless: the same charge cannot be recorded
  /// twice. Null for rows that are not tied to one specific request, and for
  /// every row written before this column existed.
  idempotencyKey String? @unique
  createdAt   DateTime @default(now())
}

model Destination {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameAr    String
  nameEn    String?
  imageUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharterBooking {
  id              String   @id @default(cuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id])
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  price           Float
  status          String   @default("requested") // requested | confirmed | cancel_requested | cancelled
  paidFromWallet  Float    @default(0)
  paidOnCredit    Float    @default(0)
  requestedAt     DateTime @default(now())
  notes           String @db.Text   @default("")
  createdAt       DateTime @default(now())

  @@index([tripId])
  @@index([companyId])
  @@index([status])
  @@index([companyId, status])
  @@index([status, createdAt])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String   @default("")
  userId     String   @default("")
  userEmail  String   @default("")
  companyId  String   @default("")
  metadata   String @db.Text   @default("{}")
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([companyId])
  @@index([action])
  @@index([createdAt])
}

model CreditLog {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  previousLimit  Float
  newLimit       Float
  changeAmount   Float
  reason         String   @default("")
  /// The booking this limit change belongs to, when there is one.
  ///
  /// A limit raised automatically to cover a booking must be traceable to
  /// that booking, and a reason string is not something you can query on. It
  /// is null for a limit a person changed by hand.
  bookingReference String?
  createdById    String
  createdByEmail String   @default("")
  createdAt      DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}

model SeatBlock {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seatLabel String
  createdAt DateTime @default(now())

  @@unique([tripId, seatLabel])
  @@index([tripId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expires])
}


