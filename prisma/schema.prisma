// CrushCar Bus Booking Platform - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  phone         String?   @default("")
  image         String?   // avatar URL (/api/uploads/...)
  role          String    @default("CUSTOMER") // SUPER_ADMIN | COMPANY_ADMIN | CUSTOMER
  permissions   String    @default("")
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  isActive      Boolean   @default(true)
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now())
  bookings      Booking[]
}

model Company {
  id               String   @id @default(cuid())
  name             String
  subdomain        String   @unique
  plan             String   @default("STARTER") // STARTER | PRO | ENTERPRISE
  creditLimit      Float    @default(0)
  walletBalance    Float    @default(0)
  paymentMode      String   @default("PREPAID") // CREDIT | PREPAID | BOTH
  outstandingBalance Float  @default(0)
  billingCycle     String   @default("MONTHLY") // MONTHLY | WEEKLY
  lastBillingDate  DateTime?
  isActive         Boolean  @default(true)
  logoUrl          String?
  showLogoOnTicket Boolean  @default(false)
  users            User[]
  buses            Bus[]
  companyCustomers CompanyCustomer[]
  companyBookings  CompanyBooking[]
  invoices         Invoice[]
  walletTransactions WalletTransaction[]
  tripRequests     TripRequest[]
  depositRequests  DepositRequest[]
  creditLogs       CreditLog[]
  charterBookings  CharterBooking[]
  reservedTrips    Trip[]   @relation("CompanyReservedTrips")
  createdAt        DateTime @default(now())
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  type      String      // MINI_BUS | COACH_BUS | VIP_BUS | DOUBLE_DECKER
  seatCount Int
  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id])
  layout    BusLayout?
  stations  BusStation[]
  trips     Trip[]
  createdAt DateTime   @default(now())
}

model Station {
  id        String     @id @default(cuid())
  name      String
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime   @default(now())
  tripStops       TripStop[]
  tripRequestsFrom TripRequest[] @relation("TripRequestFrom")
  tripRequestsTo   TripRequest[] @relation("TripRequestTo")

  @@unique([name, city])
}

model BusStation {
  id        String   @id @default(cuid())
  busId     String
  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  createdAt DateTime @default(now())

  @@unique([busId, order])
}

model BusLayout {
  id        String  @id @default(cuid())
  busId     String  @unique
  bus       Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)
  rows      Int
  cols      Int     // max columns (e.g. 4 for 2+aisle+2)
  aisleAfter Int    @default(2) // aisle position (e.g. 2 = after column 2)
  colsPerRow String @default("") // JSON: "{"A":3,"B":4,"C":3,"D":4}" - actual seat count per row
  seats     Seat[]
}

model Seat {
  id       String    @id @default(cuid())
  layoutId String
  layout   BusLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  label    String
  row      Int
  col      Int
  type     String    @default("NORMAL") // NORMAL | VIP | DISABLED | HIDDEN
  price    Float     @default(0)
}

model Trip {
  id          String     @id @default(cuid())
  busId       String
  bus         Bus        @relation(fields: [busId], references: [id])
  origin      String
  destination String
  departure   DateTime
  arrival     DateTime
  price       Float
  seatPrice           Float?
  busPrice            Float?
  bookingMode         String     @default("SEAT") // SEAT | BUS | BOTH
  reservedByCompanyId String?
  reservedByCompany   Company?   @relation("CompanyReservedTrips", fields: [reservedByCompanyId], references: [id])
  status      String     @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  stopsJson   String     @default("[]") // JSON: [{stationId, name, order, arrivalTime?, departureTime?, price?}]
  bookings    Booking[]
  companyBookings CompanyBooking[]
  charterBookings CharterBooking[]
  tripStops   TripStop[]
  seatHolds   SeatHold[]
  seatBlocks  SeatBlock[]
  createdAt   DateTime   @default(now())
}

model TripStop {
  id              String    @id @default(cuid())
  tripId          String
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stationId       String
  station         Station   @relation(fields: [stationId], references: [id])
  stopOrder       Int
  priceFromOrigin Float
  arrivalTime     DateTime?
  departureTime   DateTime?

  @@unique([tripId, stopOrder])
  @@unique([tripId, stationId])
}

model SeatHold {
  id            String   @id @default(cuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seatLabel     String
  fromStopOrder Int
  toStopOrder   Int
  userId        String
  expiresAt     DateTime
}

model Booking {
  id              String    @id @default(cuid())
  reference       String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  tripId          String
  trip            Trip      @relation(fields: [tripId], references: [id])
  seatLabel       String
  passengerName   String    @default("") // name of the actual traveler (may differ from buyer)
  passengerPhone  String    @default("") // phone number of the traveler (optional)
  passengerHotel  String    @default("")
  status          String    @default("PENDING") // PENDING | PAID | CANCELLED | BOARDED
  paidAt          DateTime?
  // Manual transfer proof (customer pays after booking, admin reviews)
  paymentMethod       String?   // VODAFONE_CASH | INSTAPAY | CASH | BANK
  paymentProofUrl     String?   // /api/uploads/... screenshot of the transfer
  paymentNotes        String?   @default("")
  paymentStatus       String    @default("NONE") // NONE | PENDING | REJECTED (awaiting review / needs new proof)
  paymentRejectReason String?   @default("")
  groupId             String?   // links seats booked in one checkout (group pay)
  boarded         Boolean   @default(false)
  boardedAt       DateTime?
  total           Float
  roundTripGroupId String?  // links outbound + return bookings in a round trip
  returnForId     String?   // if this is a return booking, links to the outbound booking
  fromStopOrder   Int       @default(1)
  toStopOrder     Int       @default(1)
  cancelledAt       DateTime?
  cancelledBy       String?
  cancellationReason String? @default("")
  refundAmount      Float?
  cancellationFee   Float?
  refundProcessedAt DateTime?
  refundProcessedBy String?
  createdAt         DateTime  @default(now())
  reminders         Reminder[]
}

model Reminder {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sentAt    DateTime @default(now())
  type      String   @default("24H") // 24H | 2H
}

model Faq {
  id         String   @id @default(cuid())
  questionAr String
  questionEn String
  answerAr   String
  answerEn   String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model CompanyCustomer {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  notes       String?  @default("")
  bookings    CompanyBooking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyBooking {
  id              String   @id @default(cuid())
  reference       String   @unique
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  customerId      String?
  customer        CompanyCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id])
  seatLabel       String
  passengerName   String   @default("")
  passengerPhone  String   @default("")
  passengerHotel  String   @default("")
  passengerNotes  String   @default("")
  collectAmount   Float?
  bookingType     String   @default("FOR_EMPLOYEE") // FOR_CLIENT | FOR_EMPLOYEE
  status          String   @default("PENDING") // PENDING | PAID | CANCELLED | BOARDED
  total           Float
  paidFromWallet  Float    @default(0)
  paidOnCredit    Float    @default(0)
  fromStopOrder   Int      @default(1)
  toStopOrder     Int      @default(1)
  expiresAt       DateTime? @map("expires_at")
  createdAt         DateTime @default(now())
  paidAt            DateTime?
  cancelledAt       DateTime?
  cancelledBy       String?
  cancellationReason String? @default("")
  refundAmount      Float?
  cancellationFee   Float?
  refundProcessedAt DateTime?
  refundProcessedBy String?
  boardedAt         DateTime?
  roundTripGroupId  String?
}

model Invoice {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  totalAmount     Float
  paidAmount      Float    @default(0)
  status          String   @default("PENDING") // PENDING | PARTIAL | PAID | OVERDUE
  dueDate         DateTime
  paidAt          DateTime?
  notes           String?  @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TripRequest {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromStationId   String
  fromStation     Station  @relation("TripRequestFrom", fields: [fromStationId], references: [id])
  toStationId     String
  toStation       Station  @relation("TripRequestTo", fields: [toStationId], references: [id])
  passengerCount  Int
  date            DateTime
  notes           String   @default("")
  status          String   @default("PENDING")
  adminNotes      String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DepositRequest {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amount         Float
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  method         String?  // VODAFONE_CASH | INSTAPAY | CASH | BANK
  notes          String?  @default("")
  adminNotes     String   @default("")
  attachmentUrl  String   @default("")
  attachmentName String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WalletTransaction {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  type        String   // DEPOSIT | BOOKING_CHARGE | REFUND | ADJUSTMENT
  amount      Float    // positive = add, negative = deduct
  description String   @default("")
  reference   String?  @default("") // bookingId or invoiceId
  createdAt   DateTime @default(now())
}

model Destination {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameAr    String
  nameEn    String?
  imageUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharterBooking {
  id              String   @id @default(cuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id])
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  price           Float
  status          String   @default("requested") // requested | confirmed | cancel_requested | cancelled
  paidFromWallet  Float    @default(0)
  paidOnCredit    Float    @default(0)
  requestedAt     DateTime @default(now())
  notes           String   @default("")
  createdAt       DateTime @default(now())

  @@index([tripId])
  @@index([companyId])
  @@index([status])
  @@index([companyId, status])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String   @default("")
  userId     String   @default("")
  userEmail  String   @default("")
  companyId  String   @default("")
  metadata   String   @default("{}")
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([companyId])
  @@index([action])
  @@index([createdAt])
}

model CreditLog {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  previousLimit  Float
  newLimit       Float
  changeAmount   Float
  reason         String   @default("")
  createdById    String
  createdByEmail String   @default("")
  createdAt      DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}

model SeatBlock {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seatLabel String
  createdAt DateTime @default(now())

  @@unique([tripId, seatLabel])
  @@index([tripId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expires])
}


